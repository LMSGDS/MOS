# Copy thành data/git-sync.env trên máy chủ, rồi chmod 600.
# Không commit file .env (đã nằm trong .gitignore).

# Fine-grained PAT: Contents (Read) + Actions (Read) trên repo LMSGDS/MOS.
MOS_GITHUB_TOKEN=github_pat_thay_bang_token
MOS_GIT_REF=main
MOS_GIT_URL=https://github.com/LMSGDS/MOS.git
MOS_SYNC_INSTALLERS=1
MOS_RESTART=1
# Mặc định lấy Full.exe 1.21.0 đã build trên cursor/micro-lms-lti-f267.
# MOS_INSTALLER_BRANCH=cursor/micro-lms-lti-f267
# MOS_INSTALLER_ARTIFACT_ID=10585480706

# Tùy chọn: webhook GitHub đẩy vào https://mos.gds.edu.vn/api/v1/hooks/github
# MOS_GITHUB_WEBHOOK_SECRET=
